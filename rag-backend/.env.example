# AI Vision RAG Backend - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# Application Settings
# ============================================================
APP_NAME="AI Vision RAG Backend"
ENVIRONMENT=development
DEBUG=true

# ============================================================
# Server Settings
# ============================================================
HOST=0.0.0.0
PORT=8000

# ============================================================
# Security (CHANGE THESE IN PRODUCTION!)
# ============================================================
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Must be 44 chars for Fernet: openssl rand -base64 32
ENCRYPTION_KEY=change-this-encryption-key-in-production-aes256!!

# ============================================================
# Vector Database (Milvus)
# ============================================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_SECURE=false

# ============================================================
# Embeddings
# ============================================================
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_DIMENSION=384
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ============================================================
# LLM - OpenAI (or Azure OpenAI)
# ============================================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Azure OpenAI (optional alternative to OpenAI)
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4-vision

# ============================================================
# PostgreSQL Database
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_metadata

# ============================================================
# Redis Cache
# ============================================================
REDIS_URL=redis://localhost:6379/0

# ============================================================
# File Storage
# ============================================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.txt,.docx,.md
UPLOAD_DIR=/app/uploads
PROCESSED_DIR=/app/processed

# ============================================================
# AWS S3 (optional - for cloud storage)
# ============================================================
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=your-bucket-name

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================
# Audit Logging
# ============================================================
ENABLE_AUDIT_LOGGING=true

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
