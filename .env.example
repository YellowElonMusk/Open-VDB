# ── VectorDB OEM Platform — Self-Hosted Configuration ──
# Copy this file to .env and fill in the values.
# All three "REQUIRED" fields must be set before running docker compose up.

# ── Database (auto-configured by docker-compose) ──
POSTGRES_USER=vectordb
POSTGRES_PASSWORD=CHANGE_ME           # REQUIRED — pick a strong password
POSTGRES_DB=vectordb_oem

# ── Embeddings ──
VDB_OPENAI_API_KEY=sk-your-key-here   # REQUIRED — your OpenAI API key

# ── Security ──
VDB_JWT_SECRET=CHANGE_ME              # REQUIRED — run: openssl rand -hex 32

# ── Optional ──
# API_PORT=8000                       # Host port for the API
# VDB_DEBUG=false                     # Enable debug logging
# UVICORN_WORKERS=2                   # API server worker count
