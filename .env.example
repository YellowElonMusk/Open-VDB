# Open VDB works locally with no required configuration.
# Copy this file to .env only when you want to customize it.

POSTGRES_USER=vectordb
POSTGRES_PASSWORD=openvdb-local
POSTGRES_DB=openvdb

# Safe default: only this computer can access the app.
VDB_BIND_ADDRESS=127.0.0.1
API_PORT=8000
VDB_LOCAL_MODE=true

# "local" is offline and free. "openai" provides stronger semantic matching.
VDB_EMBEDDING_PROVIDER=local
VDB_OPENAI_API_KEY=
VDB_EMBEDDING_MODEL=text-embedding-3-small

# Optional ingestion tuning
VDB_CHUNK_SIZE=900
VDB_CHUNK_OVERLAP=120
VDB_MAX_UPLOAD_SIZE_MB=50
VDB_MAX_BATCH_FILES=50
